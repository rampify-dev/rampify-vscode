{
  "name": "rampify",
  "displayName": "Rampify: Spec-Driven Development",
  "description": "Spec-driven development for AI coding tools. Define specs, track SEO issues, and verify fixes, so AI builds what you actually intended.",
  "version": "0.11.0",
  "publisher": "rampify",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "spec-driven development",
    "spec driven development",
    "mcp server",
    "ai seo",
    "ai coding tools",
    "feature specs",
    "cursor",
    "claude",
    "seo tools",
    "ai agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rampify-dev/rampify-vscode"
  },
  "homepage": "https://www.rampify.dev",
  "bugs": {
    "url": "https://github.com/rampify-dev/rampify-vscode/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rampify",
      "properties": {
        "rampify.apiKey": {
          "type": "string",
          "default": "",
          "description": "Deprecated. Moved to secure storage automatically.",
          "scope": "application",
          "markdownDeprecationMessage": "No longer used: Rampify credentials are kept in your editor's secret storage. Use **Rampify: Sign In** or **Rampify: Set API Key**."
        },
        "rampify.environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "local"
          ],
          "default": "production",
          "description": "API environment to connect to",
          "scope": "application"
        },
        "rampify.localApiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Local API URL (when environment is 'local')",
          "scope": "application"
        },
        "rampify.clientId": {
          "type": "string",
          "default": "",
          "description": "Client ID for this project",
          "scope": "resource"
        },
        "rampify.domain": {
          "type": "string",
          "default": "",
          "description": "Domain associated with this project",
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "rampify.signIn",
        "title": "Sign In",
        "icon": "$(sign-in)",
        "category": "Rampify"
      },
      {
        "command": "rampify.signInWithCode",
        "title": "Sign In with a Code",
        "category": "Rampify"
      },
      {
        "command": "rampify.switchProject",
        "title": "Switch Project",
        "icon": "$(arrow-swap)",
        "category": "Rampify"
      },
      {
        "command": "rampify.setupProject",
        "title": "Setup Project Link",
        "icon": "$(link)",
        "category": "Rampify"
      },
      {
        "command": "rampify.setApiKey",
        "title": "Set API Key (instead of signing in)",
        "category": "Rampify"
      },
      {
        "command": "rampify.disconnect",
        "title": "Sign Out",
        "category": "Rampify"
      },
      {
        "command": "rampify.openSignup",
        "title": "Create Free Account",
        "category": "Rampify"
      },
      {
        "command": "rampify.openDocs",
        "title": "Docs",
        "category": "Rampify"
      },
      {
        "command": "rampify.switchEnvironment",
        "title": "Switch Environment",
        "category": "Rampify"
      },
      {
        "command": "rampify.refreshFeatureSpecs",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Rampify"
      },
      {
        "command": "rampify.showSpecs",
        "title": "Show Specs",
        "icon": "$(list-tree)",
        "category": "Rampify"
      },
      {
        "command": "rampify.showSetup",
        "title": "Show Setup Checklist",
        "icon": "$(checklist)",
        "category": "Rampify"
      },
      {
        "command": "rampify.openFeatureSpec",
        "title": "Open Feature Spec in Browser",
        "icon": "$(link-external)",
        "category": "Rampify"
      },
      {
        "command": "rampify.openFeatureSpecsInBrowser",
        "title": "Open Feature Specs in Browser",
        "icon": "$(globe)",
        "category": "Rampify"
      },
      {
        "command": "rampify.copyFeatureSpecReference",
        "title": "Copy Feature Spec Reference",
        "icon": "$(copy)",
        "category": "Rampify"
      },
      {
        "command": "rampify.installMcpServer",
        "title": "Set Up MCP",
        "icon": "$(terminal)",
        "category": "Rampify"
      },
      {
        "command": "rampify.toggleResolvedSpecs",
        "title": "Show/Hide Resolved and Idea Specs",
        "icon": "$(eye)",
        "category": "Rampify"
      },
      {
        "command": "rampify.openDashboard",
        "title": "Open Dashboard",
        "category": "Rampify",
        "icon": "$(globe)"
      },
      {
        "command": "rampify.finishSetupInDashboard",
        "title": "Finish Setup in Dashboard",
        "category": "Rampify"
      },
      {
        "command": "rampify.renameProject",
        "title": "Rename Project",
        "category": "Rampify",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rampify",
          "title": "Rampify",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "rampify": [
        {
          "type": "webview",
          "id": "rampify.home",
          "name": "Home",
          "icon": "resources/icon.svg",
          "contextualTitle": "Rampify",
          "when": "rampify.view != specs"
        },
        {
          "id": "rampify.featureSpecs",
          "name": "Specs",
          "icon": "resources/icon.svg",
          "contextualTitle": "Rampify",
          "when": "rampify.view == specs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rampify.showSpecs",
          "when": "view == rampify.home",
          "group": "navigation@0"
        },
        {
          "command": "rampify.showSetup",
          "when": "view == rampify.featureSpecs",
          "group": "navigation@0"
        },
        {
          "command": "rampify.toggleResolvedSpecs",
          "when": "view == rampify.featureSpecs",
          "group": "navigation@1"
        },
        {
          "command": "rampify.refreshFeatureSpecs",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "navigation@2"
        },
        {
          "command": "rampify.openDashboard",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "1_dashboard@1"
        },
        {
          "command": "rampify.finishSetupInDashboard",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "1_dashboard@2"
        },
        {
          "command": "rampify.openFeatureSpecsInBrowser",
          "when": "view == rampify.featureSpecs",
          "group": "1_dashboard@3"
        },
        {
          "command": "rampify.renameProject",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "2_project@1"
        },
        {
          "command": "rampify.switchProject",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "2_project@2"
        },
        {
          "command": "rampify.installMcpServer",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "3_ai@1"
        },
        {
          "command": "rampify.openDocs",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "4_help@1"
        },
        {
          "command": "rampify.disconnect",
          "when": "view == rampify.home || view == rampify.featureSpecs",
          "group": "5_account@1"
        }
      ],
      "view/item/context": [
        {
          "command": "rampify.copyFeatureSpecReference",
          "when": "view == rampify.featureSpecs && viewItem == featureSpec",
          "group": "inline@1"
        },
        {
          "command": "rampify.openFeatureSpec",
          "when": "view == rampify.featureSpecs && viewItem == featureSpec",
          "group": "inline@2"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "rampify",
        "label": "Rampify"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --loader:.md=text --outfile=out/extension.js --external:vscode --platform=node --target=node20 --minify",
    "package": "npm run bundle && npx @vscode/vsce package --no-dependencies",
    "publish:vsce": "npx @vscode/vsce publish --no-dependencies --packagePath rampify-$npm_package_version.vsix",
    "publish:ovsx": "npx ovsx publish rampify-$npm_package_version.vsix -p \"${OVSX_PAT:-$(security find-generic-password -s rampify-ovsx-pat -w)}\"",
    "sync:mirror": "bash scripts/sync-mirror.sh",
    "release": "npm run package && npm run publish:vsce && npm run publish:ovsx",
    "compile": "tsc -p ./ --noEmit",
    "watch": "esbuild src/extension.ts --bundle --loader:.md=text --outfile=out/extension.js --external:vscode --platform=node --target=node20 --watch",
    "pretest": "npm run bundle && npm run lint",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.27.3",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.5"
  }
}
